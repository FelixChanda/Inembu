# Copy this file to "keystore.properties" (same directory) and fill in real values.
# keystore.properties is git-ignored — never commit it or the .jks file it points to.
#
# storeFile can be an absolute path or relative to the project root.
storeFile=/absolute/path/to/release-key.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
